generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String              @id @default(uuid()) @db.Uuid
  name           String
  phone          String?             @unique
  paypalId       String?             @unique
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deviceId       String?             @unique
  email          String?             @unique
  createdHunts   Hunt[]              @relation("CreatedHunts")
  huntsWon       Hunt[]              @relation("Winner")
  participations HuntParticipation[]
  collectedPins  Pin[]               @relation("CollectedPins")
}

model Hunt {
  id                     String              @id @default(uuid()) @db.Uuid
  type                   String
  winnerId               String?             @db.Uuid
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  creatorId              String?             @db.Uuid
  name                   String?
  creatorPhone           String?
  creatorEmail           String?
  preferredContactMethod String?
  isCompleted            Boolean             @default(false)
  completedAt            DateTime?
  creator                User?               @relation("CreatedHunts", fields: [creatorId], references: [id])
  winner                 User?               @relation("Winner", fields: [winnerId], references: [id])
  participants           HuntParticipation[]
  pins                   Pin[]
}

model Pin {
  id                String    @id @default(uuid()) @db.Uuid
  huntId            String    @db.Uuid
  lat               Decimal?
  lng               Decimal?
  distanceFt        Decimal?
  directionStr      String?
  x                 Decimal?
  y                 Decimal?
  createdAt         DateTime  @default(now())
  collectedAt       DateTime?
  collectedByUserId String?   @db.Uuid
  order             Int       @default(0)
  objectType        String    @default("coin")
  collectedByUser   User?     @relation("CollectedPins", fields: [collectedByUserId], references: [id])
  hunt              Hunt      @relation(fields: [huntId], references: [id], onDelete: Cascade)
}

model HuntParticipation {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @db.Uuid
  huntId               String   @db.Uuid
  joinedAt             DateTime @default(now())
  participantPhone     String?
  notifiedOfCompletion Boolean  @default(false)
  hunt                 Hunt     @relation(fields: [huntId], references: [id])
  user                 User     @relation(fields: [userId], references: [id])

  @@unique([userId, huntId])
}
